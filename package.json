{
  "name": "call-anyone-mcp",
  "version": "1.0.0",
  "description": "MCP server: phone anyone in their language with your own Twilio or Bland account. Language detection, goal-based scripts, cost preview, confirm-gated calling, transcripts and summaries.",
  "main": "dist/main-http.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main-http.js",
    "start:stdio": "node dist/main-stdio.js",
    "dev": "tsx src/main-http.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "twilio",
    "bland",
    "voice",
    "phone",
    "translation"
  ],
  "author": "Segun Cole",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "franc-min": "^6.2.0",
    "libphonenumber-js": "^1.13.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "call-anyone-mcp": "dist/main-stdio.js"
  }
}
